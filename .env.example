# Backend Express (bez końcowego /). BFF: /api/auth/* → proxy + httpOnly na hoście Nuxt.
# Domyślnie, jeśli puste: używane jest NUXT_PUBLIC_API_BASE (to samo co klient dla useApi).
NUXT_API_UPSTREAM=http://localhost:4000

# Adapter BFF: upstream | mock.
# Jeśli puste: kompatybilny fallback, czyli upstream przy skonfigurowanym URL,
# mock przy braku upstreamu.
NUXT_BFF_ADAPTER=

# Opcjonalnie: zewnętrzne API (useApi). Może być takie samo jak NUXT_API_UPSTREAM.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Publiczny URL aplikacji dla SEO/sitemap/OG. W build/deploy ustaw realny adres HTTPS.
NUXT_PUBLIC_SITE_URL=

# Cookies sesji. Na homelabie po HTTP ustaw false; przy HTTPS/produkcji ustaw true albo zostaw puste.
NUXT_COOKIE_SECURE=
