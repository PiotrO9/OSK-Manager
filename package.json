{
    "name": "osk-manager-fe",
    "version": "1.1.1",
    "type": "module",
    "private": true,
    "description": "Frontend aplikacji OSK Manager do zarządzania szkołą jazdy, kursantami, instruktorami, pojazdami i harmonogramem.",
    "keywords": [
        "nuxt",
        "vue",
        "typescript",
        "tailwindcss",
        "osk",
        "driving-school"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PiotrO9/OSK-Manager.git"
    },
    "engines": {
        "node": ">=24.15 <25",
        "npm": ">=11 <12"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "api:types": "openapi-typescript http://localhost:3001/openapi.json -o app/types/generated/api.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "nuxi typecheck",
        "test": "vitest run",
        "test:stage5": "node scripts/stage5-smoke.mjs",
        "test:e2e": "npm run test:e2e:ui",
        "test:e2e:ui": "node scripts/run-e2e.mjs ui",
        "test:e2e:full": "node scripts/run-e2e.mjs full",
        "test:e2e:smoke": "node scripts/run-e2e.mjs full --grep @smoke",
        "test:e2e:headed": "node scripts/run-e2e.mjs ui --headed",
        "test:e2e:report": "playwright show-report output/playwright/report",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@lucide/vue": "^1.60.0",
        "@nuxt/icon": "^2.5.1",
        "@nuxtjs/seo": "^6.0.1",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "h3": "^1.15.11",
        "nuxt": "^4.6.2",
        "reka-ui": "^2.11.0",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.17.0",
        "@nuxtjs/color-mode": "^4.0.1",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.19.2",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "jose": "^6.2.13",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "shadcn-nuxt": "^2.8.2",
        "tailwindcss": "^4.3.3",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
}
