{
    "name": "osk-manager-fe",
    "version": "1.1.1",
    "type": "module",
    "private": true,
    "description": "Frontend aplikacji OSK Manager do zarządzania szkołą jazdy, kursantami, instruktorami, pojazdami i harmonogramem.",
    "keywords": [
        "nuxt",
        "vue",
        "typescript",
        "tailwindcss",
        "osk",
        "driving-school"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/PiotrO9/OSK-Manager.git"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "api:types": "openapi-typescript http://localhost:3001/openapi.json -o app/types/generated/api.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest run",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.0",
        "@nuxt/icon": "^2.1.1",
        "@nuxtjs/seo": "^3.4.0",
        "@vueuse/core": "^14.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "embla-carousel-autoplay": "^8.6.0",
        "embla-carousel-vue": "^8.6.0",
        "lucide-vue-next": "^0.562.0",
        "nuxt": "^4.2.2",
        "reka-ui": "^2.9.5",
        "tailwind-merge": "^3.4.0",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.25",
        "vue-router": "^4.6.4",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@nuxt/eslint": "^1.12.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/vite": "^4.1.18",
        "autoprefixer": "^10.4.23",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jose": "^6.1.3",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.7.4",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "shadcn-nuxt": "^2.4.3",
        "tailwindcss": "^4.2.2",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.5"
    }
}
